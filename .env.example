# TestPilot AI - Environment Configuration Example

# Frontend Supabase Credentials (Anon/Publishable key is safe for client-side with RLS)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend API Base URL
# - When running the FastAPI backend locally on port 8000:
#   VITE_API_BASE_URL="http://localhost:8000"
# - When deployed together or in integrated full-stack mode:
#   Leave empty ("") to use relative origin API routes
VITE_API_BASE_URL="http://localhost:8000"

# Backend / Server Credentials
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Security and Storage Settings
ARTIFACT_STORAGE_BUCKET="test-evidence"

# ALLOWED_TEST_DOMAINS: Comma-separated list of hostnames or domains authorized for browser testing.
# - Initial development hosts: 'localhost' and '127.0.0.1' are always included by default.
# - To test your own deployed website or staging app, add its hostname here:
#   Example: ALLOWED_TEST_DOMAINS="localhost,127.0.0.1,my-app.vercel.app,staging.myapp.com"
# - Cloud provider metadata endpoints (169.254.169.254) and unauthorized private subnets are strictly blocked.
# - To permit all public web domains in staging, set: ALLOWED_TEST_DOMAINS="*"
ALLOWED_TEST_DOMAINS="localhost,127.0.0.1"

# AI Studio runtime vars
GEMINI_API_KEY=""
APP_URL=""
